<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             x:Class="Nova.Avalonia.Views.Panels.ProductionView"
             x:DataType="panels:ProductionViewModel">
    <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
        <TextBlock Text="{Binding PlanetName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                   IsVisible="{Binding HasPlanet}" />
        <TextBlock Text="{Binding Message}" Opacity="0.7"
                   IsVisible="{Binding HasMessage}" />

        <ItemsControl ItemsSource="{Binding Queue}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="panels:ProductionItemViewModel">
                    <!-- Two rows, not one - the name/cost/progress block needs the FULL row
                         width to stay readable (it previously shared one row with 5 fixed-width
                         button columns, which left it so cramped that even the plain item name
                         was already being clipped; adding the progress/years line below it made
                         that pre-existing crowding impossible to ignore any longer). -->
                    <StackPanel Margin="0,4" Spacing="2">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='{}{0}x '}"
                                       Foreground="{Binding TextColor}" Margin="0,0,4,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CostSummary}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                                <!-- docs/behavior-specs-5/production-queue.md §8: percent-complete
                                     of the next single unit, plus the same simulated
                                     years-to-finish estimate the row's own color already reflects
                                     (Green = done next turn, Blue = in progress, Red =
                                     "practically never", Gray = an auto-build order already
                                     satisfied with nothing to build). -->
                                <TextBlock Text="{Binding ProgressSummary}" FontSize="10" Foreground="{Binding TextColor}" Opacity="0.9" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                            <!-- Toggles this order between manual and auto-build in place - see
                                 docs/behavior-specs-4/production-queue.md §9. Always visible (not
                                 just when IsAutoBuild), since it's also how a manual order
                                 already in the queue gets turned into an auto-build one after
                                 the fact. -->
                            <Button Content="{Binding AutoBuildLabel}" Command="{Binding ToggleAutoBuildCommand}"
                                    Opacity="0.8" Padding="4,0"
                                    ToolTip.Tip="Click to toggle Auto Build - an auto-build order is skipped (not blocking) in a year it can't be afforded. Quantity is the target count to MAINTAIN, not a batch - it won't grow on its own as population/operable capacity rises, so raise it by hand once your colony can support more (this row goes gray once built count reaches it, with nothing left to do)." />
                            <!-- RepeatButton, not Button - holding it down re-invokes Command on
                                 its own built-in timer (see ProductionViewModel.
                                 IncrementAddQuantityCommand's own comment on why a hand-rolled
                                 DispatcherTimer didn't actually repeat on Android). -->
                            <RepeatButton Content="−" Padding="6,0" Command="{Binding DecrementCommand}" />
                            <RepeatButton Content="+" Padding="6,0" Command="{Binding IncrementCommand}" />
                            <Button Content="▲" Padding="4,0" Command="{Binding MoveUpCommand}" />
                            <Button Content="▼" Padding="4,0" Command="{Binding MoveDownCommand}" />
                            <Button Content="✕" Padding="4,0" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Opacity="0.25" Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding HasPlanet}" Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="Add to queue" FontWeight="Bold" Opacity="0.8" />

            <ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedAvailableItem}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="panels:ProductionCatalogItemViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding CostSummary}" FontSize="10" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Quantity" VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- ShowButtonSpinner="False" - its own tiny spin buttons don't ramp up the step
                     size, so they're replaced by the same RepeatButton -/+ pair the queue's own
                     rows use (ProductionViewModel.IncrementAddQuantityCommand's own comment); the
                     editable text box itself is kept for typing an exact large quantity directly. -->
                <NumericUpDown Grid.Column="1" Value="{Binding AddQuantity}" Minimum="1" Maximum="1000" FormatString="0"
                               ShowButtonSpinner="False"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,0" />
                <RepeatButton Grid.Column="2" Content="−" Padding="6,0" Margin="4,0,0,0"
                              Command="{Binding DecrementAddQuantityCommand}" />
                <RepeatButton Grid.Column="3" Content="+" Padding="6,0" Margin="4,0,0,0"
                              Command="{Binding IncrementAddQuantityCommand}" />
            </Grid>

            <!-- docs/behavior-specs-4/production-queue.md §9: "Factories (Auto Build) Up to 10" -
                 Quantity above plays the "Up to N" role; this just flags the order so it never
                 blocks the queue in a year it can't be afforded. -->
            <CheckBox Content="Auto Build" IsChecked="{Binding AutoBuildOnAdd}"
                      ToolTip.Tip="Skipped (not blocking) in a year this order can't be afforded, instead of halting everything queued after it" />

            <Button Content="Add to Queue" Command="{Binding AddToQueueCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
