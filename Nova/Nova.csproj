<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Nova</AssemblyName>
    <RootNamespace>Nova</RootNamespace>
    <StartupObject>Nova.Program</StartupObject>
    <ApplicationIcon>Resources\Nova.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <!-- See ControlLibrary.csproj for why WFO1000 (WinForms designer-serialization
         safety check) is suppressed project-wide rather than annotated property-by-property. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>..\Build\Debug\</OutputPath>
    <BaseOutputPath>..\Build\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\Build\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\HelpContent\**\*.*" Link="HelpContent\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    These four ComponentEditor dialog pairs (and their .resx files) exist on disk but were
    never wired into the old Nova.csproj's explicit Compile/EmbeddedResource lists - only
    HullDialog and RaceRestrictionDialog were. Preserving that exclusion here rather than
    silently pulling them into the build via implicit globbing, since including them now
    would be an unreviewed behavior change, not a framework-version bump.
  -->
  <ItemGroup>
    <Compile Remove="WinForms\ComponentEditor\Dialogs\ArmorDialog.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\ArmorDialog.Designer.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\CargoPodDialog.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\CargoPodDialog.Designer.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\MineDialog.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\MineDialog.Designer.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\ShieldDialog.cs" />
    <Compile Remove="WinForms\ComponentEditor\Dialogs\ShieldDialog.Designer.cs" />
    <EmbeddedResource Remove="WinForms\ComponentEditor\Dialogs\ArmorDialog.resx" />
    <EmbeddedResource Remove="WinForms\ComponentEditor\Dialogs\CargoPodDialog.resx" />
    <EmbeddedResource Remove="WinForms\ComponentEditor\Dialogs\MineDialog.resx" />
    <EmbeddedResource Remove="WinForms\ComponentEditor\Dialogs\ShieldDialog.resx" />
  </ItemGroup>

  <!--
    SDK-style projects compute a .resx's embedded manifest resource name from its RootNamespace
    plus its physical folder path (e.g. "Nova.WinForms.Gui.Dialogs.ResearchDialog.resources").
    The old-style csproj instead used each paired .cs file's actual DECLARED C# namespace, which
    in this codebase very often does not match the folder it lives in (long-standing, pre-existing
    inconsistency - e.g. most classes physically under WinForms/Gui/Dialogs/ and WinForms/Gui/Reports/
    declare "namespace Nova.WinForms.Gui", not ".Dialogs"/".Reports"). Any resx whose class calls
    ComponentResourceManager.GetObject(...) in InitializeComponent (typically for a designer-set
    Icon) then throws MissingManifestResourceException at runtime, because the embedded resource's
    logical name doesn't match what the compiled code asks for by the class's real namespace -
    this is exactly what crashed ResearchDialog after the .NET Framework -> .NET 9 migration.
    These overrides restore each affected resx's original (pre-migration) logical name.
  -->
  <ItemGroup>
    <EmbeddedResource Update="WinForms\ComponentEditor\DialogComponents\BasicProperties.resx">
      <LogicalName>Nova.WinForms.ComponentEditor.BasicProperties.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\ComponentEditor\DialogComponents\CommonProperties.resx">
      <LogicalName>Nova.WinForms.ComponentEditor.CommonProperties.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\ComponentEditor\DialogComponents\ImageDisplay.resx">
      <LogicalName>Nova.WinForms.ComponentEditor.ImageDisplay.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\ComponentEditor\DialogComponents\TechRequirements.resx">
      <LogicalName>Nova.WinForms.ComponentEditor.TechRequirements.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\ComponentEditor\Dialogs\HullDialog.resx">
      <LogicalName>Nova.WinForms.ComponentEditor.HullDialog.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\ComponentEditor\Dialogs\RaceRestrictionDialog.resx">
      <LogicalName>Nova.WinForms.ComponentEditor.RaceRestrictionDialog.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\FleetDetail.resx">
      <LogicalName>Nova.WinForms.Gui.FleetDetail.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\FleetSummary.resx">
      <LogicalName>Nova.WinForms.Gui.FleetSummary.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\Messages.resx">
      <LogicalName>Nova.WinForms.Gui.Messages.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\PlanetSummary.resx">
      <LogicalName>Nova.WinForms.Gui.PlanetSummary.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\SelectionDetail.resx">
      <LogicalName>Nova.WinForms.Gui.SelectionDetail.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\SelectionSummary.resx">
      <LogicalName>Nova.WinForms.Gui.SelectionSummary.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Controls\StarMap.resx">
      <LogicalName>Nova.WinForms.Gui.StarMap.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\BattlePlans.resx">
      <LogicalName>Nova.WinForms.Gui.BattlePlans.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\BattleViewer.resx">
      <LogicalName>Nova.WinForms.Gui.BattleViewer.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\CargoDialog.resx">
      <LogicalName>Nova.ControlLibrary.CargoDialog.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\DesignManager.resx">
      <LogicalName>Nova.WinForms.Gui.DesignManager.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\PlayerRelations.resx">
      <LogicalName>Nova.WinForms.Gui.PlayerRelations.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\ProductionDialog.resx">
      <LogicalName>Nova.WinForms.Gui.ProductionDialog.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\ResearchDialog.resx">
      <LogicalName>Nova.WinForms.Gui.ResearchDialog.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Dialogs\ShipDesignDialog.resx">
      <LogicalName>Nova.WinForms.Gui.ShipDesignDialog.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Reports\BattleReport.resx">
      <LogicalName>Nova.WinForms.Gui.BattleReport.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Reports\FleetReport.resx">
      <LogicalName>Nova.WinForms.Gui.FleetReport.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Reports\PlanetReport.resx">
      <LogicalName>Nova.WinForms.Gui.PlanetReport.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\Gui\Reports\ScoreReport.resx">
      <LogicalName>Nova.WinForms.Gui.ScoreReport.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="WinForms\NovaConsole.resx">
      <LogicalName>Nova.WinForms.Console.NovaConsole.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\ControlLibrary\ControlLibrary.csproj" />
    <ProjectReference Include="..\Nova.Ai\Nova.Ai.csproj" />
    <ProjectReference Include="..\Nova.Client\Nova.Client.csproj" />
    <ProjectReference Include="..\ServerState\Server.csproj" />
  </ItemGroup>

</Project>
