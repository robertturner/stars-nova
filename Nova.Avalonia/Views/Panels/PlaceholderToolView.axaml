<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             x:Class="Nova.Avalonia.Views.Panels.PlaceholderToolView"
             x:DataType="panels:PlaceholderToolViewModel">
    <Border Padding="12">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
    </Border>
</UserControl>
