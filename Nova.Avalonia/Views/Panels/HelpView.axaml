<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             x:Class="Nova.Avalonia.Views.Panels.HelpView"
             x:DataType="panels:HelpViewModel">
    <Grid ColumnDefinitions="220,*">
        <DockPanel Grid.Column="0" Margin="4">
            <TextBox DockPanel.Dock="Top" PlaceholderText="Search topics..." Text="{Binding SearchText}" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="panels:HelpTopicViewModel">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" Margin="4">
            <SelectableTextBlock Text="{Binding ContentText}" TextWrapping="Wrap" FontFamily="Courier New,monospace" />
        </ScrollViewer>
    </Grid>
</UserControl>
