<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="Nova.Avalonia.Views.Panels.BattleReportView"
             x:DataType="panels:BattleReportViewModel">
    <Grid RowDefinitions="Auto,*,Auto,*">
        <TextBlock Grid.Row="0" Text="Battles" FontWeight="Bold" Opacity="0.8" Margin="6,4" />
        <dg:DataGrid Grid.Row="1" ItemsSource="{Binding Battles}" SelectedItem="{Binding SelectedBattle}"
                     IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                     CanUserSortColumns="True" CanUserResizeColumns="True" SelectionMode="Single">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Location" Binding="{Binding Location}" />
                <dg:DataGridTextColumn Header="Starbase Present" Binding="{Binding StarbasePresent}" />
                <dg:DataGridTextColumn Header="Sides" Binding="{Binding Sides}" />
                <dg:DataGridTextColumn Header="Units" Binding="{Binding Units}" />
                <dg:DataGridTextColumn Header="Ours" Binding="{Binding Ours}" />
                <dg:DataGridTextColumn Header="Theirs" Binding="{Binding Theirs}" />
                <dg:DataGridTextColumn Header="Unarmed" Binding="{Binding Unarmed}" />
                <dg:DataGridTextColumn Header="Scout" Binding="{Binding Scout}" />
                <dg:DataGridTextColumn Header="Warship" Binding="{Binding Warship}" />
                <dg:DataGridTextColumn Header="Bomber" Binding="{Binding Bomber}" />
                <dg:DataGridTextColumn Header="Utility" Binding="{Binding Utility}" />
                <dg:DataGridTextColumn Header="Our Dead" Binding="{Binding OurDead}" />
                <dg:DataGridTextColumn Header="Their Dead" Binding="{Binding TheirDead}" />
                <dg:DataGridTextColumn Header="Ours Left" Binding="{Binding OursLeft}" />
                <dg:DataGridTextColumn Header="Theirs Left" Binding="{Binding TheirsLeft}" />
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <TextBlock Grid.Row="2" Text="Battle Log" FontWeight="Bold" Opacity="0.8" Margin="6,8,6,4"
                   IsVisible="{Binding SelectedBattle, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding StepLog}" Margin="6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
