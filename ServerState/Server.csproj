<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net9.0, not net9.0-windows/UseWindowsForms - confirmed via repo-wide grep that
         nothing under ServerState/ actually uses System.Windows.Forms/System.Drawing/
         Nova.ControlLibrary (the ControlLibrary reference below was vestigial). Portable so
         Nova.Avalonia (and, through it, Nova.Avalonia.Android) can reference Gameinitializer
         directly for a native New Game screen - see docs/PROJECT-STATUS.md's Race Designer/New
         Game port entry. -->
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Nova.Server</AssemblyName>
    <RootNamespace>Nova.Server</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>..\Build\Debug\</OutputPath>
    <BaseOutputPath>..\Build\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\Build\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

</Project>
