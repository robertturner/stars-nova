<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             xmlns:conv="using:Nova.Avalonia.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:input="using:Avalonia.Input"
             xmlns:views="using:Nova.Avalonia.Views.Panels"
             x:Class="Nova.Avalonia.Views.Panels.StarMapDocumentView"
             x:DataType="panels:StarMapDocumentViewModel">
    <UserControl.Styles>
        <Style Selector="Button.starMapMarker">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.starMapMarker:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26ffffff" />
        </Style>
        <!-- Shared Canvas positioning for the star, fleet and wormhole ItemsControls below - all
             derive from MapMarkerViewModel, which is where X/Y live. -->
        <Style Selector="ItemsControl.mapLayer ContentPresenter" x:DataType="panels:MapMarkerViewModel">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style Selector="ItemsControl.scanLayer ContentPresenter" x:DataType="panels:StarMapScanCircleViewModel">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
        <!-- Minefields already store their own top-left corner (see StarMapMineFieldViewModel),
             so they position the same way as the scan-range washes, not the small star/fleet
             markers above. -->
        <Style Selector="ItemsControl.mineLayer ContentPresenter" x:DataType="panels:StarMapMineFieldViewModel">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <!-- Starbase presence dot color - see StarMapStarViewModel.IsFullStarbase's own comment
             on why dock capacity (rather than a hardcoded hull name) is what distinguishes a full
             combat starbase from a small defense-only orbital platform. -->
        <Style Selector="Rectangle.starbaseFull">
            <Setter Property="Fill" Value="Yellow" />
        </Style>
        <Style Selector="Rectangle.starbaseSmall">
            <Setter Property="Fill" Value="Gray" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <ScrollViewer Name="MapScroll"
                      Background="#0d1117"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PointerWheelChanged="OnMapPointerWheelChanged">
            <!-- Avalonia's ScrollViewer has no WPF/UWP-style PanningMode property - touch/pen
                 drag-to-scroll instead needs an explicit ScrollGestureRecognizer. -->
            <ScrollViewer.GestureRecognizers>
                <ScrollGestureRecognizer CanHorizontallyScroll="True" CanVerticallyScroll="True" />
            </ScrollViewer.GestureRecognizers>
        <LayoutTransformControl x:Name="MapScaleHost">
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            </LayoutTransformControl.LayoutTransform>
            <Panel x:Name="MapPanel" Width="{Binding MapWidth}" Height="{Binding MapHeight}">
            <!-- Scan-range washes render first (so they sit behind the stars/fleets below)
                 and never intercept clicks. Already scanner-percentage corrected and culled
                 (StarMapDocumentViewModel.BuildScanCircles); empty while key 7 has them off. -->
            <ItemsControl Classes="scanLayer" ItemsSource="{Binding ScanCircles}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapScanCircleViewModel">
                        <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}" Fill="{Binding Fill}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Minefields - a big clickable circle per field (key 8 toggles the layer). Drawn
                 after scan washes but before the route/star/fleet layers. -->
            <ItemsControl Classes="mineLayer" ItemsSource="{Binding Minefields}" IsVisible="{Binding ShowMinefields}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapMineFieldViewModel">
                        <Button Classes="starMapMarker" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding ToolTipText}">
                            <Panel Width="{Binding Diameter}" Height="{Binding Diameter}">
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                         Fill="{Binding Color}" />
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                         Stroke="Gold" StrokeThickness="2"
                                         IsVisible="{Binding IsSelected}" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected fleet's pending route - drawn before the star/fleet markers so the
                 clickable markers sit visually on top. A leg repeating an earlier leg's endpoints
                 is dashed while key 9 (route-overlap) is on. -->
            <ItemsControl Classes="routeLayer" ItemsSource="{Binding RouteLegs}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapRouteLegViewModel">
                        <Canvas>
                            <Line StartPoint="{Binding Start}" EndPoint="{Binding End}"
                                  Stroke="{Binding LineColor}" StrokeThickness="{Binding LineThickness}"
                                  StrokeDashArray="{Binding DashArray}" />
                            <Ellipse Canvas.Left="{Binding MarkerLeft}" Canvas.Top="{Binding MarkerTop}"
                                     Width="{Binding MarkerDiameter}" Height="{Binding MarkerDiameter}"
                                     Fill="{Binding MarkerColor}" />
                            <Polygon Points="{Binding ArrowPoints}" Fill="{Binding LineColor}" />
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Wormholes this empire has detected (EmpireData.WormholeReports). -->
            <ItemsControl Classes="mapLayer" ItemsSource="{Binding Wormholes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapWormholeViewModel">
                        <Canvas>
                            <Button Classes="starMapMarker" Command="{Binding SelectCommand}"
                                    Canvas.Left="-16" Canvas.Top="-16" Width="32" Height="32"
                                    ToolTip.Tip="{Binding ToolTipText}">
                                <Panel>
                                    <Ellipse Width="16" Height="16" Stroke="Gold" StrokeThickness="2"
                                             IsVisible="{Binding IsSelected}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="10" Height="10" Stroke="{Binding Color}" StrokeThickness="1.5"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Mineral packets in flight this empire sees (EmpireData.MineralPacketReports). -->
            <ItemsControl Classes="mapLayer" ItemsSource="{Binding Packets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapPacketViewModel">
                        <Canvas>
                            <Button Classes="starMapMarker" Command="{Binding SelectCommand}"
                                    Canvas.Left="-16" Canvas.Top="-16" Width="32" Height="32"
                                    ToolTip.Tip="{Binding ToolTipText}">
                                <Panel>
                                    <Ellipse Width="12" Height="12" Stroke="Gold" StrokeThickness="2"
                                             IsVisible="{Binding IsSelected}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Width="4" Height="4" Fill="{Binding Color}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Classes="mapLayer" ItemsSource="{Binding Stars}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapStarViewModel">
                        <!-- Root is an unconstrained local Canvas positioned at the star's logical
                             (X,Y); everything below positions relative to that origin, so a long
                             name can never push the icon off its true centre. -->
                        <Canvas>
                            <!-- "Planets:" view-mode overlays (behavior-specs-10/client-interface.md,
                                 "Planet display-mode ring/bar overlay"), all centred on the planet
                                 and never hit-testable. Habitability: a dark-fill/bright-outline
                                 bullseye pair (red outside tolerance, green inside, olive when the
                                 exact and estimated readings disagree). -->
                            <Ellipse Width="{Binding HabitabilityOuterDiameter}" Height="{Binding HabitabilityOuterDiameter}"
                                     Canvas.Left="{Binding HabitabilityOuterOffset}" Canvas.Top="{Binding HabitabilityOuterOffset}"
                                     Fill="{Binding HabitabilityFill}" Stroke="{Binding HabitabilityStroke}" StrokeThickness="1"
                                     IsVisible="{Binding ShowHabitabilityRing}" IsHitTestVisible="False" />
                            <Ellipse Width="{Binding HabitabilityInnerDiameter}" Height="{Binding HabitabilityInnerDiameter}"
                                     Canvas.Left="{Binding HabitabilityInnerOffset}" Canvas.Top="{Binding HabitabilityInnerOffset}"
                                     Fill="{Binding HabitabilityStroke}"
                                     IsVisible="{Binding ShowHabitabilityRing}" IsHitTestVisible="False" />
                            <!-- Population: one solid ring, green own / yellow friendly / red otherwise. -->
                            <Ellipse Width="{Binding PopulationRingDiameter}" Height="{Binding PopulationRingDiameter}"
                                     Canvas.Left="{Binding PopulationRingOffset}" Canvas.Top="{Binding PopulationRingOffset}"
                                     Fill="{Binding PopulationBrush}" Stroke="{Binding PopulationBrush}" Opacity="0.85"
                                     IsVisible="{Binding ShowPopulationRing}" IsHitTestVisible="False" />
                            <!-- Minerals: the 3-segment bar (blue / dark green / yellow, in that order),
                                 0-20 steps tall, standing just above the icon. -->
                            <Rectangle Width="3" Height="{Binding IroniumBarHeight}" Fill="Blue"
                                       Canvas.Left="-4.5" Canvas.Top="{Binding IroniumBarTop}"
                                       IsVisible="{Binding ShowMineralBars}" IsHitTestVisible="False" />
                            <Rectangle Width="3" Height="{Binding BoraniumBarHeight}" Fill="#008000"
                                       Canvas.Left="-1.5" Canvas.Top="{Binding BoraniumBarTop}"
                                       IsVisible="{Binding ShowMineralBars}" IsHitTestVisible="False" />
                            <Rectangle Width="3" Height="{Binding GermaniumBarHeight}" Fill="Yellow"
                                       Canvas.Left="1.5" Canvas.Top="{Binding GermaniumBarTop}"
                                       IsVisible="{Binding ShowMineralBars}" IsHitTestVisible="False" />

                            <!-- Tap target (32x32) is deliberately bigger than the visible 16x16
                                 selection ring/dot below. Still bound to Command as a fallback - see
                                 MapPanel's own Tunnel-phase handler in the code-behind. The hover
                                 tooltip is the planet tooltip (mode 7). -->
                            <Button Classes="starMapMarker" Command="{Binding SelectCommand}"
                                    Canvas.Left="-16" Canvas.Top="-16" Width="32" Height="32"
                                    ToolTip.Tip="{Binding ToolTipText}">
                                <Panel>
                                    <Ellipse Width="16" Height="16"
                                             Stroke="Gold" StrokeThickness="2"
                                             IsVisible="{Binding IsSelected}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                             Fill="{Binding Color}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                            <!-- The habitability mode's small square for a planet with no owner. -->
                            <Rectangle Width="{Binding UnownedMarkerSize}" Height="{Binding UnownedMarkerSize}"
                                       Canvas.Left="{Binding UnownedMarkerOffset}" Canvas.Top="{Binding UnownedMarkerOffset}"
                                       Fill="{Binding HabitabilityStroke}"
                                       IsVisible="{Binding ShowUnownedMarker}" IsHitTestVisible="False" />
                            <!-- Fleet-in-orbit ring - two size classes (behavior-specs-10/
                                 client-interface.md, "Fleet-in-orbit ring"): 11x11 normally, 19x19
                                 while this planet is the tracked (selected) object; light-gray /
                                 red / magenta for own / foreign / both (the small one a two-tone
                                 bevel, the large one white / red / magenta single-tone). -->
                            <Ellipse Width="{Binding OrbitRingDiameter}" Height="{Binding OrbitRingDiameter}"
                                     Canvas.Left="{Binding OrbitRingOffset}" Canvas.Top="{Binding OrbitRingOffset}"
                                     Stroke="{Binding OrbitRingStroke}" StrokeThickness="1" IsHitTestVisible="False"
                                     IsVisible="{Binding HasFleetsInOrbit}" />
                            <Ellipse Width="{Binding OrbitRingInnerDiameter}" Height="{Binding OrbitRingInnerDiameter}"
                                     Canvas.Left="{Binding OrbitRingInnerOffset}" Canvas.Top="{Binding OrbitRingInnerOffset}"
                                     Stroke="{Binding OrbitRingInnerStroke}" StrokeThickness="1" IsHitTestVisible="False"
                                     IsVisible="{Binding HasFleetsInOrbit}" />
                            <!-- Starbase capability dots - up to three small colored squares, one
                                 per independent condition, each at its own fixed offset from the
                                 star icon. Colors are this port's own choice. -->
                            <Rectangle Width="4" Height="4" IsHitTestVisible="False"
                                       Classes.starbaseFull="{Binding IsFullStarbase}" Classes.starbaseSmall="{Binding !IsFullStarbase}"
                                       Canvas.Left="5" Canvas.Top="-8" IsVisible="{Binding HasStarbase}"
                                       ToolTip.Tip="{Binding IsFullStarbase, Converter={x:Static conv:StarbaseTooltipConverter.Instance}}" />
                            <Rectangle Width="4" Height="4" Fill="Cyan" IsHitTestVisible="False"
                                       Canvas.Left="-9" Canvas.Top="-8" IsVisible="{Binding HasStargate}"
                                       ToolTip.Tip="Stargate" />
                            <Rectangle Width="4" Height="4" Fill="Magenta" IsHitTestVisible="False"
                                       Canvas.Left="5" Canvas.Top="4" IsVisible="{Binding HasMassDriver}"
                                       ToolTip.Tip="Mass Driver" />
                            <!-- Horizontally centred on the anchor point via a TranslateTransform
                                 bound to this TextBlock's own measured width. Key 0 toggles it. -->
                            <TextBlock x:Name="StarNameLabel" Text="{Binding Name}" Foreground="White" FontSize="10"
                                       Canvas.Left="0" Canvas.Top="10" IsVisible="{Binding ShowName}" IsHitTestVisible="False">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{Binding #StarNameLabel.Bounds.Width, Converter={x:Static conv:NegateHalfConverter.Instance}}" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Classes="mapLayer" ItemsSource="{Binding Fleets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="panels:StarMapFleetViewModel">
                        <!-- Local Canvas root, same reasoning as the star marker above. -->
                        <Canvas>
                            <Button Classes="starMapMarker" Command="{Binding SelectCommand}"
                                    Canvas.Left="-16" Canvas.Top="-16" Width="32" Height="32"
                                    ToolTip.Tip="{Binding ToolTipText}"
                                    input:InputElement.IsHoldingEnabled="True" Holding="OnFleetMarkerHolding">
                                <Panel>
                                    <!-- Points form a triangle pointing DOWN at Bearing=0, matching
                                         StarMap.cs's own `triangle` field, rotated to the heading. -->
                                    <Polygon Points="5,9 10,0 0,0"
                                             Fill="{Binding Color}" IsVisible="{Binding ShowTriangle}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             RenderTransformOrigin="50%,50%">
                                        <Polygon.RenderTransform>
                                            <RotateTransform Angle="{Binding Bearing}" />
                                        </Polygon.RenderTransform>
                                    </Polygon>
                                    <!-- Tracked-object chevron (behavior-specs-10/client-interface.md,
                                         "Deep-space fleet marker"): while this fleet is the tracked
                                         (selected) object its icon is replaced by the fixed 11x11
                                         chevron, blue own / red otherwise, never rotated. -->
                                    <Path Data="{x:Static panels:StarMapFleetViewModel.ChevronGeometry}"
                                          Fill="{Binding ChevronBrush}" Width="11" Height="11" Stretch="None"
                                          IsVisible="{Binding ShowChevron}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                            <!-- Ship-count badge (Shift+0 toggles it). -->
                            <TextBlock Text="{Binding ShipCountDisplay}" Foreground="{Binding Color}"
                                       FontSize="9" FontWeight="Bold" IsHitTestVisible="False"
                                       Canvas.Left="6" Canvas.Top="2" IsVisible="{Binding ShowBadge}" />
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Panel>
        </LayoutTransformControl>
        </ScrollViewer>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                Background="#aa000000" CornerRadius="4" Padding="8,4">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <!-- The 9 fixed zoom steps (View > Zoom 25%-400%); +/- step through them - a
                         touchscreen never raises a wheel event, so these are the only way to zoom
                         at all on Android. -->
                    <ComboBox ItemsSource="{Binding ZoomLevelLabels}" SelectedIndex="{Binding ZoomLevelIndex}"
                              VerticalAlignment="Center" MinWidth="80" ToolTip.Tip="Zoom" />
                    <Button Content="-" Command="{Binding ZoomOutCommand}" Padding="10,2" FontWeight="Bold" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" Padding="10,2" FontWeight="Bold" />
                    <Button Content="Reset" Command="{Binding ResetZoomCommand}" Padding="6,2" />
                    <!-- Measures from whatever's currently selected to the next thing tapped. -->
                    <Button Content="Measure" Command="{Binding MeasureDistanceCommand}" Padding="8,2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <!-- The shared 6-way "Planets:" selector (keys 1-6), which picks the planet
                         ring/bar overlay. -->
                    <TextBlock Text="Planets:" Foreground="White" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PlanetModeLabels}" SelectedIndex="{Binding PlanetMode}"
                              VerticalAlignment="Center" MinWidth="170" />
                    <Button Content="View" Padding="8,2">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Spacing="4" MinWidth="220">
                                    <CheckBox Content="Scan circles (7)" IsChecked="{Binding ShowScanCircles}" />
                                    <CheckBox Content="Minefields (8)" IsChecked="{Binding ShowMinefields}" />
                                    <CheckBox Content="Dash overlapping route legs (9)" IsChecked="{Binding ShowRouteOverlap}" />
                                    <CheckBox Content="Planet names (0)" IsChecked="{Binding ShowPlanetNames}" />
                                    <CheckBox Content="Ship counts (Shift+0)" IsChecked="{Binding ShowShipCountBadges}" />
                                    <TextBlock Text="{Binding ScannerPercentage, StringFormat='Scanner display {0}%'}" Margin="0,6,0,0" />
                                    <!-- Below 100% the drawn circles grow (radius x 100 / percentage);
                                         changing it turns the scan circles on. -->
                                    <Slider Minimum="2" Maximum="100" Value="{Binding ScannerPercentage}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- View > Find (Ctrl+F) - windowed UI only; the code-behind hides it on Android. -->
                    <Button x:Name="FindButton" Content="Find" Command="{Binding Search.OpenCommand}" Padding="8,2"
                            ToolTip.Tip="Find an object (Ctrl+F)" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Find dialog (View > Find / Ctrl+F): a query over every object this empire knows
             about; the chosen result becomes the selection and is centred on the map. -->
        <Border DataContext="{Binding Search}" x:DataType="panels:StarMapSearchViewModel"
                IsVisible="{Binding IsOpen}" Background="#ee101018" BorderBrush="DodgerBlue"
                BorderThickness="1" CornerRadius="4" Padding="8" Margin="8"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="300">
            <StackPanel Spacing="6">
                <TextBlock Text="Find" FontWeight="Bold" Foreground="White" />
                <TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="Name">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding GoCommand}" />
                        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <ComboBox ItemsSource="{x:Static panels:StarMapSearchViewModel.KindLabels}" SelectedIndex="{Binding KindIndex}"
                          HorizontalAlignment="Stretch" />
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" MaxHeight="220"
                         DoubleTapped="OnSearchResultDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="panels:StarMapSearchResultViewModel">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No matching object" Foreground="Gray" IsVisible="{Binding NoResult}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Go to" Command="{Binding GoCommand}" Padding="8,2" />
                    <Button Content="Close" Command="{Binding CloseCommand}" Padding="8,2" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- "Add Waypoint" arming is triggered from the Inspector panel but shown here, since
             it's this map that the next tap actually targets. -->
        <Border IsVisible="{Binding IsAddingWaypoint}" Background="#442299ff" BorderBrush="DodgerBlue"
                BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Tap a star, fleet, minefield or wormhole to add a waypoint" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelAddWaypointCommand}" Padding="8,2" />
            </StackPanel>
        </Border>

        <!-- "Measure Distance" arming/result - same floating-banner pattern as "Add Waypoint". -->
        <Border IsVisible="{Binding IsMeasuringDistance}" Background="#442299ff" BorderBrush="DodgerBlue"
                BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Tap a star, fleet, minefield or wormhole to measure the distance to it" VerticalAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelMeasureCommand}" Padding="8,2" />
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding MeasureDistanceResult, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                Background="#dd101018" BorderBrush="DodgerBlue" BorderThickness="1" CornerRadius="4"
                Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding MeasureDistanceResult}" Foreground="White" VerticalAlignment="Center" />
                <Button Content="Dismiss" Command="{Binding CancelMeasureCommand}" Padding="8,2" />
            </StackPanel>
        </Border>

        <views:HullViewerView DataContext="{Binding HullViewer}" />
    </Grid>
</UserControl>
