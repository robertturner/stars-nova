<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nova.Avalonia.ViewModels"
             x:Class="Nova.Avalonia.Views.Controls.ResearchCostSelector"
             x:DataType="vm:ResearchCostViewModel">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
            <RadioButton GroupName="{Binding Title}" Content="Costs 50% less" IsChecked="{Binding IsCheap}" />
            <RadioButton GroupName="{Binding Title}" Content="Costs standard amount" IsChecked="{Binding IsStandard}" />
            <RadioButton GroupName="{Binding Title}" Content="Costs 75% extra" IsChecked="{Binding IsExpensive}" />
        </StackPanel>
    </Border>
</UserControl>
