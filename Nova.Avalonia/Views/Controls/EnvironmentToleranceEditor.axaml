<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nova.Avalonia.ViewModels"
             x:Class="Nova.Avalonia.Views.Controls.EnvironmentToleranceEditor"
             x:DataType="vm:EnvironmentToleranceViewModel">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" />
                <CheckBox Grid.Column="1" Content="Immune" IsChecked="{Binding Immune}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding !Immune}">
                <TextBlock Grid.Column="0" Text="Min" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MinValue}" />
                <TextBlock Grid.Column="2" Text="{Binding FormattedMin}" VerticalAlignment="Center" Width="60" Margin="8,0,0,0" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding !Immune}">
                <TextBlock Grid.Column="0" Text="Max" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MaxValue}" />
                <TextBlock Grid.Column="2" Text="{Binding FormattedMax}" VerticalAlignment="Center" Width="60" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
