<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             x:Class="Nova.Avalonia.Views.Panels.PlaceholderDocumentView"
             x:DataType="panels:PlaceholderDocumentViewModel">
    <Border Padding="12" Background="#0d1117">
        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
