<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             x:Class="Nova.Avalonia.Views.Panels.ResearchView"
             x:DataType="panels:ResearchViewModel">
    <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
        <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="panels:ResearchFieldRowViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="&#9679;" Foreground="Gold" Margin="0,0,6,0"
                                   IsVisible="{Binding IsCurrentTarget}" />
                        <TextBlock Grid.Column="1" Text="{Binding Field}" />
                        <TextBlock Grid.Column="2" Text="{Binding Level, StringFormat='Level {0}'}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="3" Text="{Binding ResourcesBanked, StringFormat='{}{0} banked'}" Opacity="0.6" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Change research" FontWeight="Bold" Opacity="0.8" Margin="0,16,0,0" />

        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Target" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TargetFieldOptions}" SelectedItem="{Binding SelectedTargetField}" HorizontalAlignment="Stretch" />
        </Grid>
        <!-- research-tech-tree.md section 4: the field to switch to once the target gains a
             level (same field, a named field, or the lowest field). -->
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Next" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding NextFieldOptions}" SelectedIndex="{Binding SelectedNextFieldIndex}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Where research goes once the target field gains a level" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Budget %" VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumericUpDown Grid.Column="1" Value="{Binding EditableBudget}" Minimum="0" Maximum="100" FormatString="0"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,0" />
        </Grid>

        <Button Content="Apply" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" IsVisible="{Binding HasStatusMessage}" />

        <!-- Live preview for whatever target field/budget is currently selected above - not yet
             applied - matching WinForms ResearchDialog's ParameterChanged, which recomputes on
             every RadioButton/NumericUpDown change rather than only once Apply/OK is clicked. -->
        <TextBlock Text="Completing next level" FontWeight="Bold" Opacity="0.8" Margin="0,16,0,0" />
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Available energy" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding AvailableEnergy}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Budgeted this turn" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding BudgetedEnergy}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Resources needed" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding CompletionResourcesText}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="Years to complete" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding CompletionTimeText}" />
        </Grid>

        <!-- Every component that further research in the selected target field alone would
             eventually unlock, each with the detail card's status line (research-tech-tree.md §7a);
             parts the race can never receive are omitted. -->
        <TextBlock Text="Expected research benefits" FontWeight="Bold" Opacity="0.8" Margin="0,16,0,0" />
        <ItemsControl ItemsSource="{Binding Benefits}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="panels:ResearchBenefitRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                        <!-- The detail card's one status line (research-tech-tree.md §4). -->
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </ScrollViewer>
</UserControl>
