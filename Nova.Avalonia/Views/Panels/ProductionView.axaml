<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:Nova.Avalonia.ViewModels.Panels"
             x:Class="Nova.Avalonia.Views.Panels.ProductionView"
             x:DataType="panels:ProductionViewModel"
             PointerReleased="OnPointerReleased">
    <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
        <TextBlock Text="{Binding PlanetName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                   IsVisible="{Binding HasPlanet}" />
        <TextBlock Text="{Binding Message}" Opacity="0.7"
                   IsVisible="{Binding HasMessage}" />

        <ItemsControl ItemsSource="{Binding Queue}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="panels:ProductionItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='{}{0}x'}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding CostSummary}" FontSize="10" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Auto" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsAutoBuild}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                            <Button Content="−" Padding="6,0" Command="{Binding DecrementCommand}"
                                    PointerPressed="OnDecrementPointerPressed" />
                            <Button Content="+" Padding="6,0" Command="{Binding IncrementCommand}"
                                    PointerPressed="OnIncrementPointerPressed" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
                            <Button Content="▲" Padding="4,0" Command="{Binding MoveUpCommand}" />
                            <Button Content="▼" Padding="4,0" Command="{Binding MoveDownCommand}" />
                        </StackPanel>
                        <Button Grid.Column="5" Content="✕" Padding="4,0" Margin="4,0,0,0" Command="{Binding DeleteCommand}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding HasPlanet}" Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="Add to queue" FontWeight="Bold" Opacity="0.8" />

            <ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedAvailableItem}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="panels:ProductionCatalogItemViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding CostSummary}" FontSize="10" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Quantity" VerticalAlignment="Center" Margin="0,0,8,0" />
                <NumericUpDown Grid.Column="1" Value="{Binding AddQuantity}" Minimum="1" Maximum="1000" FormatString="0"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,0" />
            </Grid>

            <Button Content="Add to Queue" Command="{Binding AddToQueueCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
