<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately plain net9.0, not net9.0-windows/UseWindowsForms - Common is the portable
         game-data/rules layer shared by every host (WinForms Nova.exe, Avalonia desktop, and
         eventually an Android head); see docs/PROJECT-STATUS.md's Android-portability section for
         how its former System.Windows.Forms/System.Drawing dependencies (dialogs, MessageBox,
         ProgressDialog, Bitmap fields) were removed via Nova.Common.PlatformHooks. -->
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Nova.Common</AssemblyName>
    <RootNamespace>Nova.Common</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>..\Build\Release\</OutputPath>
    <BaseOutputPath>..\Build\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\VersionInfo.cs" Link="VersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\components.xml" Link="components.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
